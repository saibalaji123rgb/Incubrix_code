# ==============================================================================
# IncuBrix AEO, SEO & GEO Visibility Engine - Environment Configuration
# ==============================================================================
# NOTE: All tools and core workflows are fully functional with ZERO paid APIs ($0.00 spend).
# The engine operates natively in MANUAL_CAPTURE mode without any external credentials.
# To optionally enable official API collection adapters, supply your keys below.
# NEVER commit your actual .env file or expose credentials in version control.
# ==============================================================================

# Target Web Property
INCUBRIX_TARGET_DOMAIN=https://incubrix.com
DATA_COLLECTION_MODE=MANUAL_CAPTURE

# Optional Google Search Collection (Official APIs)
SERPAPI_API_KEY=
PAGESPEED_API_KEY=

# Optional AI Assistant Collection (Official APIs)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Logging & Storage
ENGINE_LOG_LEVEL=INFO
DATABASE_PATH=Engine/data/incubrix_visibility.db
